{
  "//": "Tests run in Node under Vitest and may read the source tree, so they get node types. Kept separate from tsconfig.app.json so application code cannot reach for process or fs by accident.",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-setup.ts"]
}
