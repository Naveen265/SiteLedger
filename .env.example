# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local.

# Supabase project URL, from Project settings, Data API.
VITE_SUPABASE_URL=

# The anon public key. Row Level Security is what protects your data, so this
# key is safe in the browser. The service role key is never used by this app.
VITE_SUPABASE_ANON_KEY=

# The public URL the app is served from. Used for password reset links.
VITE_SITE_URL=http://localhost:5173

# Phone plus OTP login needs a paid SMS provider (MSG91, Twilio, MessageBird).
# Leave this false to use email and password, which works on the free tier.
VITE_AUTH_PHONE_ENABLED=false

# Where uploaded photos are stored. "supabase" is free and is the default.
# Adding an S3 or Azure Blob provider means one new file in src/lib/storage
# and changing this value. No screen or module changes.
VITE_STORAGE_PROVIDER=supabase
