# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local.
#
# ---------------------------------------------------------------------------
# SERVER ONLY. These have no VITE_ prefix, which is what keeps them out of the
# browser bundle: Vite only inlines VITE_ prefixed variables. They are read by
# the proxy at api/supabase/[...path].ts in production, and by the dev proxy in
# vite.config.ts locally. Neither value is ever sent to a client.
# ---------------------------------------------------------------------------

# Supabase project URL, from Project settings, Data API.
SUPABASE_URL=

# The anon public key, from the same page. The service role key is never used
# anywhere in this project and must not be put here.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# CLIENT. These are compiled into the bundle and are visible to anyone. Nothing
# here is a credential.
# ---------------------------------------------------------------------------

# The public URL the app is served from. Used for password reset links.
VITE_SITE_URL=http://localhost:5173

# Phone plus OTP login needs a paid SMS provider (MSG91, Twilio, MessageBird).
# Leave this false to use email and password, which works on the free tier.
VITE_AUTH_PHONE_ENABLED=false

# Where uploaded photos are stored. "supabase" is free and is the default.
VITE_STORAGE_PROVIDER=supabase
